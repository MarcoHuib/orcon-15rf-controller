# RAM and IRAM: what moves to flash (measured one by one on QEMU and the board, docs/MATTER.md "Geheugen").

# Non-ISR FreeRTOS functions in flash (ISR-callable ones stay in IRAM)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Whole heap component in flash; Kconfig requires the SPI master ISR out of IRAM too
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# Non-ISR ring-buffer functions in flash (the UART ISR's FromISR calls stay in IRAM)
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# esp_event_post() not callable from IRAM ISRs (nothing in Orcon/Matter posts from an ISR)
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# RX robustness: UART ISR in IRAM, so DIO2 bytes keep flowing into the 8 KB ring buffer during flash writes
CONFIG_UART_ISR_IN_IRAM=y

# Matter event-log buffers only (the low-risk part of e14): older events roll off sooner
CONFIG_EVENT_LOGGING_CRIT_BUFFER_SIZE=2048
CONFIG_EVENT_LOGGING_INFO_BUFFER_SIZE=512
CONFIG_EVENT_LOGGING_DEBUG_BUFFER_SIZE=256

# Keep assertions, drop their file/line strings
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# OLED I2C master ISR in flash: it is not IRAM-safe anyway (CONFIG_I2C_ISR_IRAM_SAFE=n), only placed in IRAM for speed
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
